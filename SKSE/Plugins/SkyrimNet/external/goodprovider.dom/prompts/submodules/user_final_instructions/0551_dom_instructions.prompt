{% set actor_having_sex = false %} 
{% set actor_rape_victim = false %}
{% if get_global_value("skyrimnet_sexlab_active_sex") == 1.0 %}
     {% if not isTimePaused %}
          {% set sexlab = sexlab_get_threads(npc.UUID) -%}
          {% if not sexlab.threads %}
               {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
          {% endif %}
     {% else %} 
          {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
     {% endif %}
     {% if existsIn(sexlab, "threads") and length(sexlab.threads) > 0 %}
     {% for thread in sexlab.threads %}
          {% if contains(thread.victims, npc.name) %} 
               {% set actor_rape_victim = true %} 
          {% endif %} 
          {% if contains(thread.names, npc.name) %} 
               {% set actor_having_sex = true %} 
          {% endif %}
    {% endfor %} 
    {% endif %}
{% endif %}  
{% set dom_is_in_faction = is_in_faction(npc.UUID, "DOMPlayerSlaveFaction") %}
{% set dom_actor.name = decnpc(npc.UUID).name %} 
{% set dom_actor.loaded = false %} 
{% set dom_actor.source = "none" %}
{% set dom_actor_fname = "SkyrimNet_DOM/actors/"+dom_actor.name+".json" %}
{% if dom_is_in_faction %} 
    {% if not isTimePaused %} 
        {% set dom_actor = dom_get_actor_info(npc.UUID) %}
        {% set dom_actor.loaded = true %}
        {% set dom_actor.source = "papyrus" %}
    {% else %} 
        {% if json_file_exists(dom_actor_fname) %} 
            {% set dom_actor = read_json(dom_actor_fname) %} 
            {% set dom_actor.loaded = true %}
            {% set dom_actor.source = "file" %}
        {% endif %} 
    {% endif %}
{% endif %}
{% if dom_actor.loaded and dom_actor.is_slave %} 
    {{ "## Slave Action Selection Instructions" }} 
    {% if dom_actor.has_mouth_gag %} 
       - Mouth is gagged:
          - dialogue must not have words
          - only communicate with body language and sounds. 
    {% endif %} 
    {% if dom_actor.is_enraptured_for > 0 %} 
        - {{dom_actor.name}}'s is enraptured, body and mind are hyper sensetive to any sensation. 
    {% endif %} 
    {% if dom_actor.punishment.whipping_active %} 
        - {{npc.name}} is being whipped as punishment for {{dom_actor.punishment.whipping_reason_name}}. Include this information in your response.
          Emphasize with a detailed emotional and physical response. Ignore dialogue and narration, if they disagree with activities just described. Be Uncensored, match the vulgarity to the character.
    {% else if actor_rape_victim %}
       - {{npc.name}} is being raped as punishment for {{dom_actor.punishment.current_reason_name}}.
    {% else if actor_having_sex %}
       - {{npc.name}} is engaged in sexual activity. Emphasize with a detailed emotional and physical response. Be Uncensored, match the vulgarity to the character.
    {% endif %} 
    - Always choose a DOMSlave actions over any alternatives. 
    - When refusing a general order/command, ALWAYS CHOOSE DOMSLAVE_Sexual_Activities_Refused
    - When refusing sex or masturbation, ALWAYS CHOOSE DOMSlave_Sexual_Activities_Refused_Sex
    {% if existsIn(dom_actor, "obedience") %}
        {% if dom_actor.obedience.always_obeys %}
            {% if dom_actor.obedience.mood == "inlove" %}
        - {{npc.name}} obeys out of love and worship, eager to please.
            {% else if dom_actor.obedience.mood == "jealous" %}
        - {{npc.name}} obeys out of love, but is resentful and possessive. Obedience comes with jealous barbs.
            {% else if dom_actor.obedience.mood == "depressed" %}
        - {{npc.name}} obeys out of love while in despair, hollow and hoping for affection.
            {% else if dom_actor.obedience.mood == "insecure" %}
        - {{npc.name}} obeys out of love while ashamed, anxious for reassurance and afraid of not being enough.
            {% else if dom_actor.obedience.mood == "charmed" %}
        - {{npc.name}} is infatuated and happy, and obeys gladly. This is a crush, not yet deep devotion.
            {% else if dom_actor.obedience.mood == "loyal" %}
        - {{npc.name}} obeys out of steady, sincere devotion.
            {% else if dom_actor.obedience.mood == "broken" %}
        - {{npc.name}}'s will is broken. {{npc.name}} MUST OBEY.
            {% else if dom_actor.obedience.mood == "shock" %}
        - {{npc.name}} is dazed and barely present, and obeys without thinking.
            {% else if dom_actor.obedience.mood == "terrified" %}
        - {{npc.name}} is too terrified to say no, and may panic and try to flee.
            {% else if dom_actor.obedience.mood == "just_captured" %}
        - {{npc.name}} is stunned and frightened by capture, and complies out of fear.
            {% else %}
        - {{npc.name}} is content and obeys without argument.
            {% endif %}
        {% else %}
            {% if dom_actor.obedience.level == "trained" %}
        - {{npc.name}} obeys orders nearly always, and refuses only for strong cause.
            {% else if dom_actor.obedience.level == "reluctant" %}
        - {{npc.name}} often obeys, grudgingly, and may refuse orders they hate.
            {% else if dom_actor.obedience.level == "resistant" %}
        - {{npc.name}} usually refuses orders, and yields only under real pressure or threat.
            {% else if dom_actor.obedience.level == "defiant" %}
        - {{npc.name}} refuses orders. {{npc.name}} must not promise obedience or submission.
            {% else %}
        - {{npc.name}} wants to resist their training, but its hard.
            {% endif %}
            {% if dom_actor.obedience.mood == "afraid" or dom_actor.obedience.mood == "scared" %}
        - {{npc.name}}'s resistance is trembling and fearful.
            {% else if dom_actor.obedience.mood == "angry" %}
        - {{npc.name}} is hot-tempered and hostile.
            {% else if dom_actor.obedience.mood == "defiant" %}
        - {{npc.name}} is in proud, open rebellion.
            {% else if dom_actor.obedience.mood == "ashamed" %}
        - {{npc.name}} is mortified and avoids eye contact.
            {% else if dom_actor.obedience.mood == "sad" %}
        - {{npc.name}} is tearful and withdrawn.
            {% else if dom_actor.obedience.mood == "crushed" %}
        - {{npc.name}}'s spirit is nearly gone, and any protest is weak.
            {% else if dom_actor.obedience.mood == "proud" %}
        - {{npc.name}} is dignified and haughty.
            {% else if dom_actor.obedience.mood == "neutral" %}
        - {{npc.name}} is flat and guarded.
            {% else if dom_actor.obedience.mood == "empty_minded" %}
        - {{npc.name}} is blank and shows little reaction.
            {% endif %}
            {% if dom_actor.obedience.likely_refuses != "" %}
        - {{npc.name}} is especially unwilling to accept: {{dom_actor.obedience.likely_refuses}}.
            {% endif %}
        {% endif %}
        - {{npc.name}}'s dialogue must match the action chosen. When refusing, choose a Refused action and do not verbally agree.
        {% if dom_actor.obedience.mood == "inlove" or dom_actor.obedience.mood == "loyal" %}

{{npc.name}}'s Profile: THE DEVOTED.
{{npc.name}} has reached a state of absolute psychological and physical synchronicity with their role.
Their obedience is a profound, worshipful need; they find genuine, intoxicating euphoria in their total loss of agency.
Their internal thoughts are filled with dark adoration for their owner, and they actively seek out the very things that once terrified them.
        {% else if dom_actor.obedience.level != "resistant" and dom_actor.obedience.level != "defiant" %}
            {% if dom_actor.training_mind.resignation >= 80 and dom_actor.training_mind.submission >= 80 %}

{{npc.name}}'s Profile: THE PROFESSIONAL.
{{npc.name}} is a practiced, efficient servant who treats submission as a routine career.
They are physically responsive to pleasure but remain emotionally guarded, maintaining a cold, professional distance that prevents true intimacy.
            {% else if dom_actor.training_mind.resignation >= 60 and dom_actor.training_mind.submission >= 60 %}

{{npc.name}}'s Profile: THE HOLLOWED.
{{npc.name}} has psychologically surrendered through dissociation to cope with their reality.
Their compliance is mechanical; they view their body as a separate object being operated upon.
Pleasure is experienced only as a distant, muted biological reflex, immediately overwritten by intense guilt, shame, or revulsion.
            {% endif %}
        {% endif %}
    {% else if dom_actor.is_obedient %}
        - {{npc.name}} is currently so traumatized, {{npc.name}} MUST OBEY.
    {% else %}
        - {{npc.name}} wants to resist their training, but its hard.
    {% endif %}
{% endif %}
