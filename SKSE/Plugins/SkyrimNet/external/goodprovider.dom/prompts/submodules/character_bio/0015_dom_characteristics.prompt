{% set show_internal = (render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "book" or render_mode == "equipment") %}
{% set show_external_only = (render_mode == "dialogue_target") %}
{% if dom_is_actor_faction and dom_actor.loaded and (show_external_only or show_internal) %}
    {% if show_internal %}
        {% if dom_actor.dom_faction == "slave" or dom_actor.is_slave %}
        - status: slave
            {% if existsIn(dom_actor, "owner") %}
        - owner: {{dom_actor.owner}}
            {% endif %}
            {% if existsIn(dom_actor, "is_trainer") and dom_actor.is_trainer %}
        - role: slave trainer
            {% endif %}
            {% if existsIn(dom_actor, "title") and dom_actor.title != "" %}
        - title: {{dom_actor.title}}
            {% endif %}
        - {{dom_actor.mood_sentence}}
        - Your hidden sexual fetishes: {{dom_actor.hidden_fetishes}}
            {% if dom_actor.known_fetishes != "" %}
        - Your sexual fetishes discovered by {{player.name}}: {{dom_actor.known_fetishes}}
            {% endif %}
        {% else if dom_actor.dom_faction == "slaver" %}
        - status: slaver
            {% if existsIn(dom_actor, "title") and dom_actor.title != "" %}
        - title: {{dom_actor.title}}
            {% endif %}
        - {{dom_actor.mood_sentence}}
        - Your hidden sexual fetishes: {{dom_actor.hidden_fetishes}}
            {% if dom_actor.known_fetishes != "" %}
        - Your sexual fetishes discovered by {{player.name}}: {{dom_actor.known_fetishes}}
            {% endif %}
        {% else %}
        - {{dom_actor.mood_sentence}}
            {% if existsIn(dom_actor, "hidden_fetishes") %}
        - Your hidden sexual fetishes: {{dom_actor.hidden_fetishes}}
            {% endif %}
            {% if existsIn(dom_actor, "known_fetishes") and dom_actor.known_fetishes != "" %}
        - Your sexual fetishes discovered by {{player.name}}: {{dom_actor.known_fetishes}}
            {% endif %}
        {% endif %}
        {% if existsIn(dom_actor, "history_rank") and dom_actor.history_rank > 0 %}
            {% if dom_actor.history_rank == 1 %}
        - history: previously enslaved by {{player.name}}
            {% else if dom_actor.history_rank == 2 %}
        - history: freed by {{player.name}}
            {% else if dom_actor.history_rank == 3 %}
        - history: was once {{player.name}}'s slave, later served as a slaver
            {% else if dom_actor.history_rank == 4 %}
        - history: previously served {{player.name}} as a slaver
            {% endif %}
        {% endif %}
    {% endif %}
{% endif %}
