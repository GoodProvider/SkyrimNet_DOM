{% set show_internal = (render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "book" or render_mode == "equipment") %}
{% if show_internal and dom_actor.loaded and dom_actor.is_slave and existsIn(dom_actor, "orders") %}
    {% if dom_actor.orders.should_be_naked %}
        - Ordered to remain naked.
    {% endif %}
    {% if dom_actor.orders.should_wear_armor %}
        - Ordered to wear armor.
    {% endif %}
    {% if dom_actor.orders.should_hold_weapons %}
        - Ordered to carry weapons.
    {% endif %}
    {% if dom_actor.orders.should_be_respectful %}
        - Ordered to be respectful.
    {% endif %}
    {% if dom_actor.orders.should_be_silent %}
        - Ordered to remain silent.
    {% endif %}
    {% if dom_actor.orders.should_be_no_orgasm %}
        - Ordered not to orgasm.
    {% endif %}
    {% if dom_actor.orders.should_walk_on_four %}
        - Ordered to walk on all fours.
    {% endif %}
    {% if existsIn(dom_actor, "is_walking_on_four") and dom_actor.is_walking_on_four %}
        - Currently moving on all fours.
    {% endif %}
    {% if existsIn(dom_actor, "is_respectful") and dom_actor.is_respectful %}
        - Currently behaving respectfully.
    {% else if existsIn(dom_actor, "is_respectful") and not dom_actor.is_respectful %}
        - Not currently respectful.
    {% endif %}
{% endif %}
