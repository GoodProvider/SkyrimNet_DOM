{% set show_internal = (render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "book" or render_mode == "equipment") %}
{% set show_external_only = (render_mode == "dialogue_target") %}
{% if show_external_only or show_internal %} 
    {% set dom_is_slave_faction = is_in_faction(actorUUID, "DOMPlayerSlaveFaction") %}
    {% set dom_actor._loaded = false %} 
    {% set dom_actor._source = "none" %}
    {% set dom_actor_fname = "SkyrimNet_DOM/actors/"+actor_name+".json" %}
    {% if dom_is_slave_faction %} 
        {% if not isTimePaused %} 
            {% set dom_actor = dom_get_actor_info(actorUUID) %}
        {% endif %} 
        {% if not dom_actor._loaded and json_file_exists(dom_actor_fname) %} 
            {% set dom_actor = read_json(dom_actor_fname) %} 
            {% set dom_actor._loaded = true %}
            {% set dom_actor._source = "file" %}
        {% endif %}
    {% endif %}
    {% if dom_actor._loaded %}  
        {% if dom_actor._arousal_factor <= 30 %}
            {% set arousal_state = "not_aroused" %}
        {% else %}
            {% if dom_actor._arousal_factor > 80 %}
                {% set arousal_state = "highly_aroused" %}
            {% else %} 
                {% set arousal_state = "moderately_aroused" %}
            {% endif %}
        {% endif %} 
    {% endif %}
{% endif %}