{% set show_internal = (render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "book" or render_mode == "equipment") %}
{% if show_internal and dom_actor.loaded and dom_actor.dom_faction == "slaver" %}
    {% if existsIn(dom_actor, "trainee_count") %}
        {% if dom_actor.trainee_count > 0 %}
        - Current trainees ({{dom_actor.trainee_count}}): {{dom_actor.trainee_names}}
        {% else %}
        - Current trainees: none
        {% endif %}
    {% endif %}
    {% if existsIn(dom_actor, "camp_name") and dom_actor.camp_name != "" %}
        - Camp: {{dom_actor.camp_name}}
    {% endif %}
    {% if existsIn(dom_actor, "is_love_interest") and dom_actor.is_love_interest %}
        - {{dom_actor.name}} is a romantic love interest of {{player.name}}
    {% endif %}
    {% if existsIn(dom_actor, "skills") %}
        - **Enforcer skill**: {%- if dom_actor.skills.enforcer < 25 -%}
          novice at physical slave training.
        {% else if dom_actor.skills.enforcer < 50 %}
          competent at breaking slaves with pain and discipline.
        {% else if dom_actor.skills.enforcer < 75 %}
          skilled at physically training and punishing slaves.
        {% else if dom_actor.skills.enforcer < 95 %}
          highly skilled at enforcing obedience through pain.
        {% else %}
          master of physical slave training and punishment.
        {% endif %}
        - **Persuader skill**: {%- if dom_actor.skills.persuader < 25 -%}
          poor at intimidating or recruiting.
        {% else if dom_actor.skills.persuader < 50 %}
          can scare and pressure others into compliance.
        {% else if dom_actor.skills.persuader < 75 %}
          good at intimidation and persuasion in slavery work.
        {% else if dom_actor.skills.persuader < 95 %}
          very effective at cowing resistance and recruiting.
        {% else %}
          master of fear and persuasion as a slaver.
        {% endif %}
        - **Depraver skill**: {%- if dom_actor.skills.depraver < 25 -%}
          inexperienced at sexual training of slaves.
        {% else if dom_actor.skills.depraver < 50 %}
          knows the basics of sexual slave training.
        {% else if dom_actor.skills.depraver < 75 %}
          skilled at corrupting and sexually training slaves.
        {% else if dom_actor.skills.depraver < 95 %}
          expert at sexual training and humiliation of slaves.
        {% else %}
          master of sexual training and depravity.
        {% endif %}
        - **Predator skill**: {%- if dom_actor.skills.predator < 25 -%}
          clumsy at capturing new slaves.
        {% else if dom_actor.skills.predator < 50 %}
          capable of capturing slaves with effort.
        {% else if dom_actor.skills.predator < 75 %}
          skilled hunter of new slaves.
        {% else if dom_actor.skills.predator < 95 %}
          highly effective at taking captives.
        {% else %}
          master predator at capturing slaves.
        {% endif %}
        - **Slaver skill**: {%- if dom_actor.skills.slaver < 25 -%}
          poor at selling and trading slaves.
        {% else if dom_actor.skills.slaver < 50 %}
          can manage basic slave sales.
        {% else if dom_actor.skills.slaver < 75 %}
          good at trading and selling slaves.
        {% else if dom_actor.skills.slaver < 95 %}
          excellent merchant of flesh.
        {% else %}
          master of the slave trade.
        {% endif %}
        - **Deceiver skill**: {%- if dom_actor.skills.deceiver < 25 -%}
          inept at ransoms and deception.
        {% else if dom_actor.skills.deceiver < 50 %}
          can handle simple ransom schemes.
        {% else if dom_actor.skills.deceiver < 75 %}
          skilled at ransom and deceit in the trade.
        {% else if dom_actor.skills.deceiver < 95 %}
          highly skilled at ransoming and deception.
        {% else %}
          master of ransom and deception.
        {% endif %}
    {% endif %}
    {% if existsIn(dom_actor, "career") %}
        - Career: captured {{dom_actor.career.captured}}, sold {{dom_actor.career.sold}}, whored {{dom_actor.career.whored}}, ransomed {{dom_actor.career.ransomed}}, broken {{dom_actor.career.broken}}, recruited slavers {{dom_actor.career.recruited_slavers}}
    {% endif %}
{% endif %}
