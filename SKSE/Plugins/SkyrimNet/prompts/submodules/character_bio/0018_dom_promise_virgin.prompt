{% set show_internal = (render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "book" or render_mode == "equipment") %}
{% if show_internal and dom_actor.loaded %}
    {% if dom_actor.is_slave and existsIn(dom_actor, "promise_rank") and dom_actor.promise_rank > 0 %}
        {% if dom_actor.promise_rank == 1 %}
        - Promise owed: freedom.
        {% else if dom_actor.promise_rank == 2 %}
        - Promise owed: money.
        {% else if dom_actor.promise_rank == 3 %}
        - Promise owed: to be treated gently.
        {% else if dom_actor.promise_rank == 4 %}
        - Promise owed: pain.
        {% else if dom_actor.promise_rank == 5 %}
        - Promise owed: rapture.
        {% else if dom_actor.promise_rank == 6 %}
        - Promise owed: to be sacrificed.
        {% else if existsIn(dom_actor, "promise_oath") and dom_actor.promise_oath != "" and dom_actor.promise_oath != "nothing" %}
        - Promise owed: {{dom_actor.promise_oath}}.
        {% endif %}
    {% endif %}
    {% if existsIn(dom_actor, "virgin") %}
        {% if dom_actor.virgin.vaginal == 0 %}
        - Vaginal virgin.
        {% else if dom_actor.virgin.vaginal == 1 %}
        - Vaginal virginity will soon be lost.
        {% else if dom_actor.virgin.vaginal == 2 %}
        - {{player.name}} took their vaginal virginity.
        {% else if dom_actor.virgin.vaginal == 3 %}
        - Someone else took their vaginal virginity.
        {% else if dom_actor.virgin.vaginal == 4 %}
        - Lost vaginal virginity long ago.
        {% endif %}
        {% if dom_actor.virgin.oral == 0 %}
        - Oral virgin.
        {% else if dom_actor.virgin.oral == 1 %}
        - Oral virginity will soon be lost.
        {% else if dom_actor.virgin.oral == 2 %}
        - {{player.name}} took their oral virginity.
        {% else if dom_actor.virgin.oral == 3 %}
        - Someone else took their oral virginity.
        {% else if dom_actor.virgin.oral == 4 %}
        - Lost oral virginity long ago.
        {% endif %}
        {% if dom_actor.virgin.anal == 0 %}
        - Anal virgin.
        {% else if dom_actor.virgin.anal == 1 %}
        - Anal virginity will soon be lost.
        {% else if dom_actor.virgin.anal == 2 %}
        - {{player.name}} took their anal virginity.
        {% else if dom_actor.virgin.anal == 3 %}
        - Someone else took their anal virginity.
        {% else if dom_actor.virgin.anal == 4 %}
        - Lost anal virginity long ago.
        {% endif %}
        {% if dom_actor.virgin.same == 0 %}
        - Same-gender sex virgin.
        {% else if dom_actor.virgin.same >= 2 %}
        - Has had same-gender sex.
        {% endif %}
        {% if dom_actor.virgin.gangbang == 0 %}
        - Never been in a gangbang.
        {% else if dom_actor.virgin.gangbang >= 2 %}
        - Has been in a gangbang.
        {% endif %}
    {% endif %}
{% endif %}
